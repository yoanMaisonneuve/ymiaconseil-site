{
  "name": "Plans d'atelier",
  "short_name": "Plans",
  "description": "Lecteur de dessins d'atelier : un clic sur un mur ouvre sa feuille, un clic sur une coupe ouvre son détail.",
  "lang": "fr-CA",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#14233c",
  "theme_color": "#14233c",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./partage",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "plan", "accept": ["application/pdf", ".pdf"] }]
    }
  }
}
